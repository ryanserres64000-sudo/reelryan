# Clé API Anthropic (obligatoire) : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Code d'accès demandé aux visiteurs avant d'utiliser l'IA (fortement conseillé)
APP_PASSWORD=
# Optionnel
# RR_MODEL=claude-opus-5-5
# RR_EFFORT=medium
# Galerie de musique : clé gratuite sur https://developer.jamendo.com (test ; licence commerciale à signer avant la sortie)
# JAMENDO_CLIENT_ID=
# MaDA Pro : clé secrète RevenueCat (active la limite gratuite et la vérification de l'abonnement)
# REVENUECAT_SECRET_KEY=
# FREE_PER_DAY=15
# REVENUECAT_ENTITLEMENT=pro

# --- App mobile (npm run mobile:build) ---
# Adresse du serveur MaDA déployé, appelé par l'app iOS / Android
# MADA_API_BASE=https://ton-app.vercel.app
# Clés publiques RevenueCat (Project settings → API keys)
# MADA_RC_IOS_KEY=appl_...
# MADA_RC_ANDROID_KEY=goog_...

# --- Comptes (Supabase : https://supabase.com, région Europe) ---
# Project settings → API. Exécute une fois supabase/schema.sql dans le SQL Editor.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   (secrète, uniquement sur le serveur)

# --- Instagram et TikTok (publication directe et statistiques) ---
# Adresse publique du site, utilisée pour les retours de connexion : APP_URL/api/social/callback
# APP_URL=https://ton-app.vercel.app
# Clé de chiffrement des jetons (32 caractères aléatoires ou plus)
# SOCIAL_TOKEN_KEY=
# Meta for Developers → app « Instagram API with Instagram login »
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# TikTok for Developers → Login Kit + Content Posting API
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
