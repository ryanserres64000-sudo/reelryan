# Clé API Anthropic (obligatoire) : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Code d'accès demandé aux visiteurs avant d'utiliser l'IA (fortement conseillé)
APP_PASSWORD=
# Optionnel
# RR_MODEL=claude-opus-5-5
# RR_EFFORT=medium
# Galerie de musique : clé gratuite sur https://developer.jamendo.com (test ; licence commerciale à signer avant la sortie)
# JAMENDO_CLIENT_ID=
# MaDA Pro : clé secrète RevenueCat (active la limite gratuite et la vérification de l'abonnement)
# REVENUECAT_SECRET_KEY=
# FREE_PER_DAY=15
# REVENUECAT_ENTITLEMENT=pro

# --- App mobile (npm run mobile:build) ---
# Adresse du serveur MaDA déployé, appelé par l'app iOS / Android
# MADA_API_BASE=https://ton-app.vercel.app
# Clés publiques RevenueCat (Project settings → API keys)
# MADA_RC_IOS_KEY=appl_...
# MADA_RC_ANDROID_KEY=goog_...
