{
  "expo": {
    "name": "Ma DA",
    "slug": "madastudio",
    "scheme": "madastudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F0D12",
    "ios": {
      "bundleIdentifier": "com.madastudio.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [{ "CFBundleTypeName": "Son", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.audio", "public.mp3", "com.apple.m4a-audio", "public.aac-audio", "com.microsoft.waveform-audio"] }]
      }
    },
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#FBF8F3", "dark": { "backgroundColor": "#0F0D12" } }],
      ["expo-image-picker", { "photosPermission": "Ma DA ouvre les vidéos et photos que tu choisis pour les monter. Elles restent sur ton iPhone.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
