{
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/music.js": {
      "maxDuration": 60
    },
    "api/social.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/social/:action",
      "destination": "/api/social?action=:action"
    }
  ]
}
